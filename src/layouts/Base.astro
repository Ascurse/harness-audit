---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --text: #1d1d1f;
    --muted: #5a5a60;
    --bg: #fbfbf8;
    --surface: #ffffff;
    --border: #d4d4cf;
    --accent: #1f5fbf;
    --warning-bg: #fff3d6;
    color-scheme: light dark;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --text: #ececec;
      --muted: #a8a8ae;
      --bg: #161618;
      --surface: #202024;
      --border: #3c3c42;
      --accent: #8ab4ff;
      --warning-bg: #3a2f12;
    }
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 16px/1.5 system-ui, sans-serif;
  }

  main {
    max-width: 52rem;
    margin: 0 auto;
    padding: 1.5rem 1rem 4rem;
  }

  a {
    color: var(--accent);
  }

  :focus-visible {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
  }

  input,
  textarea,
  button {
    font: inherit;
    color: inherit;
  }

  textarea,
  input[type='text'],
  input[type='number'] {
    width: 100%;
    padding: 0.4rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--surface);
  }

  button {
    padding: 0.5rem 1rem;
    border: 1px solid var(--accent);
    border-radius: 6px;
    background: var(--surface);
    cursor: pointer;
  }

  button:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .hint {
    color: var(--muted);
    font-size: 0.9rem;
  }
</style>
